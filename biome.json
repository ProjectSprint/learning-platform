{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/application/compat/**"],
								"message": "Compatibility layer retired. Use domain/read and current GameState shapes."
							},
							{
								"group": ["**/runtime/selectors/**"],
								"message": "Import selector/read APIs from domain/read."
							},
							{
								"group": ["**/domain/space/validation"],
								"message": "Use domain/read (isEntityPlacementAllowed, getEntitySpaceId) instead."
							},
							{
								"group": ["**/domain/entity/entity-fns"],
								"message": "Entity constructors moved to domain/adt. Use domain/read + domain/transformers for behavior logic."
							},
							{
								"group": ["**/domain/space/space-fns"],
								"message": "Space constructors moved to domain/adt. Use domain/read + domain/transformers for behavior logic."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
